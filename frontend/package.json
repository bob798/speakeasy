{
  "name": "speakeasy-frontend",
  "private": true,
  "version": "0.8.0-rc1",
  "type": "module",
  "description": "Speakeasy H5 + PWA 前端 (Vue 3 + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{js,vue}' --max-warnings 0",
    "lint:fix": "eslint 'src/**/*.{js,vue}' --fix",
    "size": "size-limit"
  },
  "dependencies": {
    "@iconify/vue": "^4.1.2",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@size-limit/preset-app": "^12.1.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "size-limit": "^11.0.0",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.2.0"
  },
  "size-limit": [
    {
      "path": "dist/assets/*.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "path": "dist/assets/*.css",
      "limit": "100 KB",
      "gzip": true
    }
  ],
  "engines": {
    "node": ">=20.10.0"
  }
}
