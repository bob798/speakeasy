# Speakeasy Production Environment
# Copy this file to .env.production and fill in your values

# Domain (used by Caddy for auto-HTTPS)
DOMAIN=speak.example.com

# LLM Provider: anthropic | volcengine | deepseek | zhipu
MODEL_PROVIDER=volcengine

# API Keys (fill in the ones you need)
VOLCENGINE_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# ZHIPU_API_KEY=

# Model config
MODEL_NAME=deepseek-v3-250324
MAX_TOKENS=1024

# Database path (inside Docker volume)
SPEAKEASY_DB_PATH=/data/speakeasy.db

# Streaming
ENABLE_STREAMING=true

# CORS (set to your domain in production)
ALLOWED_ORIGINS=https://speak.example.com
